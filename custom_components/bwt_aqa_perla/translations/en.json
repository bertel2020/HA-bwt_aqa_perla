          "usb": "USB / serial",
          "tcp": "Network (ser2net / TCP)"
        }
      },
      "usb": {
        "title": "USB / serial",
        "data": {
          "serial_port": "Device",
          "baudrate": "Baud rate"
        },
        "data_description": {
          "serial_port": "Device path of the interface. Prefer stable /dev/serial/by-id/… paths.",
          "baudrate": "The existing setup uses 9600 baud; SoftControl uses a fixed 19200 baud. Use the setting of the actual appliance."
        }
      },
      "tcp": {
        "title": "Serial over TCP (ser2net)",
        "data": {
          "host": "Host",
          "tcp_port": "TCP port"
        },
        "data_description": {
          "host": "IP address or hostname of the machine running ser2net or of the transparent serial TCP bridge.",
          "tcp_port": "Raw TCP port of the bridge; for ser2net the tcp accepter port (default 8899), not Telnet/RFC2217."
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect",
      "invalid_response": "The device responded with an invalid frame",
      "unknown": "Unexpected error",
      "invalid_host": "Invalid host"
    },
