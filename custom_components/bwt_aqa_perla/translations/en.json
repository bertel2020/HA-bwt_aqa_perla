{
  "title": "BWT AQA Perla",
  "config": {
    "step": {
      "user": {
        "title": "Select connection",
        "description": "How is the BWT AQA Perla connected to Home Assistant?",
        "menu_options": {
          "usb": "USB / serial",
          "tcp": "Network (ser2net / TCP)"
        }
      },
      "reconfigure": {
        "title": "Change connection",
        "description": "How is the BWT AQA Perla connected to Home Assistant?",
